# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
SESSION_SECRET=nexus-curate-change-this-in-production-abc123xyz

# Optional: override the SQLite file location (the container uses /app/data/database.sqlite)
# DB_PATH=./database.sqlite

# ─── Bootstrap Users (seeded on first startup, stored hashed in DB) ───────────
# Admin account
BOOTSTRAP_ADMIN_USERNAME=admin_bago
BOOTSTRAP_ADMIN_PASSWORD=Admin@2026!

# Reviewer account
BOOTSTRAP_REVIEWER_USERNAME=masticn_user
BOOTSTRAP_REVIEWER_PASSWORD=Reviewer@2026!

# ─── LLM (OpenAI-compatible API) ──────────────────────────────────────────────
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=<TOKEN>
LLM_MODEL=gpt-6-luna

# Request timeout in milliseconds (optional)
LLM_TIMEOUT_MS=60000
