<!-- Editable knowledge base title -->
<form id="doc-title-<%= doc.id %>"
      hx-put="/api/documents/<%= doc.id %>/title"
      hx-target="this"
      hx-swap="outerHTML"
      hx-indicator="#title-spin-<%= doc.id %>"
      class="flex items-center gap-1.5">
    <input type="text" name="title" required maxlength="200"
           value="<%= doc.title || '' %>"
           title="Edit title"
           class="w-full min-w-[12rem] bg-gray-900 border border-gray-700 text-gray-200 text-sm rounded px-2 py-1.5 outline-none focus:border-brand-500">
    <button type="submit" title="Save title"
            class="shrink-0 text-emerald-400 hover:text-emerald-300 bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/20 p-1.5 rounded transition-colors">
        <i id="title-spin-<%= doc.id %>" class="ph ph-check htmx-indicator-spin"></i>
    </button>
</form>
