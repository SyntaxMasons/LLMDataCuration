<!-- Admin Approval / Review Card Partial -->
<%
    const savedFlag    = (typeof saved !== 'undefined') && saved;
    const docSelector  = '#approval-document-' + qa.id;
    const systemWrapId = 'approval-system-prompt-' + qa.id;
    const turnsListId  = 'approval-turns-' + qa.id;
    const turnPrefix   = 'qa-' + qa.id;

    const turns = (Array.isArray(qa.turns) && qa.turns.length > 0)
        ? qa.turns
        : [
            { role: 'user',      content: qa.prompt },
            { role: 'assistant', content: qa.answer }
          ];
%>
<div class="bg-gray-900 border border-gray-800 rounded-xl p-5 shadow-sm space-y-4 transition-all hover:border-gray-700" id="qa-card-<%= qa.id %>">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-gray-800 pb-3">
        <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-brand-500/10 text-brand-400 flex items-center justify-center border border-brand-500/20 font-bold text-xs">
                #<%= qa.id %>
            </div>
            <div>
                <h4 class="text-sm font-semibold text-gray-200">
                    Source: <span class="text-brand-400"><%= qa.document ? qa.document.filename : 'Knowledge Base Document' %></span>
                </h4>
                <div class="text-[11px] text-gray-500 flex items-center gap-2">
                    <span>Submitted by <strong class="text-gray-400"><%= qa.reviewer ? qa.reviewer.username : 'Reviewer' %></strong></span>
                    <span>•</span>
                    <span><%= new Date(qa.updatedAt || qa.createdAt).toLocaleDateString() %></span>
                    <span>•</span>
                    <span><%= Math.ceil(turns.length / 2) %> turn<%= Math.ceil(turns.length / 2) === 1 ? '' : 's' %></span>
                </div>
            </div>
        </div>
        
        <div class="flex items-center gap-2">
            <% if (savedFlag) { %>
                <span class="text-emerald-400 text-[11px] font-medium flex items-center gap-1">
                    <i class="ph ph-check-circle"></i> Saved
                </span>
            <% } %>
            <% if (qa.status === 'approved') { %>
                <span class="bg-emerald-500/10 text-emerald-400 text-xs px-2.5 py-1 rounded-full border border-emerald-500/20 font-medium flex items-center gap-1">
                    <i class="ph ph-check-circle"></i> Approved
                </span>
            <% } else if (qa.status === 'rejected') { %>
                <span class="bg-red-500/10 text-red-400 text-xs px-2.5 py-1 rounded-full border border-red-500/20 font-medium flex items-center gap-1">
                    <i class="ph ph-x-circle"></i> Rejected
                </span>
            <% } else { %>
                <span class="bg-amber-500/10 text-amber-400 text-xs px-2.5 py-1 rounded-full border border-amber-500/20 font-medium flex items-center gap-1">
                    <i class="ph ph-clock"></i> Pending Approval
                </span>
            <% } %>
        </div>
    </div>

    <form class="space-y-4" id="approval-form-<%= qa.id %>">
        <input type="hidden" name="documentId" id="approval-document-<%= qa.id %>" value="<%= qa.documentId %>">

        <!-- System Prompt -->
        <div class="bg-gray-850 border border-gray-700 rounded-lg p-4 space-y-3 shadow-sm">
            <div class="flex items-center justify-between gap-2">
                <label class="text-[11px] font-semibold uppercase tracking-wider text-gray-400 flex items-center gap-1">
                    <i class="ph ph-terminal-window"></i> System Prompt
                </label>
                <button type="button"
                        hx-post="/api/qa/regenerate-system-prompt"
                        hx-include="<%= docSelector %>"
                        hx-vals='js:{previousPrompt: document.querySelector("#<%= systemWrapId %> textarea[name=systemPrompt]").value}'
                        hx-target="#<%= systemWrapId %>"
                        hx-swap="innerHTML"
                        hx-indicator="#approval-spin-system-<%= qa.id %>"
                        class="text-xs flex items-center gap-1.5 text-purple-400 hover:text-purple-300 bg-purple-500/10 hover:bg-purple-500/20 px-2.5 py-1.5 rounded transition-all border border-purple-500/20 shadow-sm font-medium">
                    <i id="approval-spin-system-<%= qa.id %>" class="ph ph-arrows-clockwise text-sm htmx-indicator-spin"></i> Regenerate
                </button>
            </div>
            <div id="<%= systemWrapId %>">
                <textarea name="systemPrompt" required rows="2" class="w-full bg-gray-900 border border-gray-700 text-gray-300 text-sm rounded-md focus:ring-brand-500 focus:border-brand-500 block p-2.5 outline-none resize-none transition-colors"><%= qa.systemPrompt || '' %></textarea>
            </div>
        </div>

        <!-- Turns (editable, including follow-ups) -->
        <div id="<%= turnsListId %>" class="space-y-4">
            <% for (let i = 0; i < turns.length; i += 2) { %>
                <%
                    const userTurn      = turns[i];
                    const assistantTurn = turns[i + 1];
                    const promptText    = userTurn ? (userTurn.content ?? userTurn.prompt ?? '') : '';
                    const answerText    = assistantTurn ? (assistantTurn.content ?? assistantTurn.answer ?? '') : '';
                %>
                <%- include('qa-turn', {
                    turnIndex:          (i / 2) + 1,
                    prompt:             promptText,
                    answer:             answerText,
                    turnIdPrefix:       turnPrefix,
                    documentIdSelector: docSelector
                }) %>
            <% } %>
        </div>

        <!-- Admin Feedback & Actions -->
        <div class="pt-2 border-t border-gray-800 space-y-3">
            <div>
                <label class="text-[11px] font-medium text-gray-400 block mb-1">Admin Notes / Feedback (Optional):</label>
                <input type="text"
                       name="adminFeedback"
                       placeholder="e.g. Verified against architecture diagram v1.2"
                       value="<%= qa.adminFeedback || '' %>"
                       class="w-full bg-gray-850 border border-gray-700 text-gray-200 text-xs rounded-md px-3 py-2 outline-none focus:ring-1 focus:ring-brand-500">
            </div>

            <div class="flex flex-wrap items-center justify-between gap-2.5">
                <button type="button"
                        hx-delete="/api/admin/qa/<%= qa.id %>"
                        hx-target="#qa-card-<%= qa.id %>"
                        hx-swap="outerHTML"
                        hx-confirm="Delete Q&amp;A pair #<%= qa.id %>? This cannot be undone."
                        class="px-3.5 py-1.5 text-xs font-medium text-red-400 bg-red-500/10 border border-red-500/20 rounded-lg hover:bg-red-500/20 transition-all flex items-center gap-1.5">
                    <i class="ph ph-trash text-sm"></i> Delete
                </button>

                <div class="flex items-center gap-2.5">
                    <button type="button"
                            hx-put="/api/admin/qa/<%= qa.id %>"
                            hx-include="#approval-form-<%= qa.id %>"
                            hx-target="#qa-card-<%= qa.id %>"
                            hx-swap="outerHTML"
                            class="px-3.5 py-1.5 text-xs font-medium text-brand-300 bg-brand-500/10 border border-brand-500/20 rounded-lg hover:bg-brand-500/20 transition-all flex items-center gap-1.5">
                        <i class="ph ph-floppy-disk text-sm"></i> Save Changes
                    </button>
                    <button type="button"
                            hx-post="/api/admin/qa/<%= qa.id %>/reject"
                            hx-include="#approval-form-<%= qa.id %>"
                            hx-target="#qa-card-<%= qa.id %>"
                            hx-swap="outerHTML"
                            class="px-3.5 py-1.5 text-xs font-medium text-red-400 bg-red-500/10 border border-red-500/20 rounded-lg hover:bg-red-500/20 transition-all flex items-center gap-1.5">
                        <i class="ph ph-x text-sm"></i> Reject
                    </button>
                    <button type="button"
                            hx-post="/api/admin/qa/<%= qa.id %>/approve"
                            hx-include="#approval-form-<%= qa.id %>"
                            hx-target="#qa-card-<%= qa.id %>"
                            hx-swap="outerHTML"
                            class="px-4 py-1.5 text-xs font-medium text-white bg-emerald-600 rounded-lg hover:bg-emerald-500 transition-all shadow-md shadow-emerald-600/20 flex items-center gap-1.5">
                        <i class="ph ph-check text-sm"></i> Approve &amp; Finalize
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>
