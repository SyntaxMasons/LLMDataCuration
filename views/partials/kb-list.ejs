<!-- Knowledge Base Listing View -->
<div class="h-full overflow-y-auto p-4 lg:p-6 fade-in">
    <div class="max-w-7xl mx-auto space-y-5">

        <!-- Page header -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div>
                <h2 class="text-2xl font-bold text-white flex items-center gap-2">
                    <i class="ph ph-database text-brand-400"></i> Knowledge Bases
                </h2>
                <p class="text-sm text-gray-400 mt-1">
                    <span id="kb-total-count"><%= documents.length %></span> item<%= documents.length === 1 ? '' : 's' %> · add a page, then open it in the Review Queue to curate Q&amp;A.
                </p>
            </div>
            <div class="flex items-center gap-2">
                <a href="/review" class="px-4 py-2.5 text-sm font-medium text-gray-300 bg-gray-800 border border-gray-700 rounded-lg hover:bg-gray-700 hover:text-white transition-colors flex items-center gap-2">
                    <i class="ph ph-pencil-simple"></i> <%= currentUser && currentUser.role === 'admin' ? 'Review & Approval' : 'Review Queue' %>
                </a>
                <button type="button" onclick="toggleIngestPanel()" id="ingest-new-btn"
                        class="px-4 py-2.5 text-sm font-medium text-white bg-brand-600 rounded-lg hover:bg-brand-500 shadow-lg shadow-brand-500/20 transition-all flex items-center gap-2">
                    <i class="ph ph-plus-circle"></i> Ingest New
                </button>
            </div>
        </div>

        <!-- Ingest New panel (hidden until toggled) -->
        <div id="ingest-panel" class="hidden bg-gray-900 border border-brand-500/30 rounded-2xl p-5 shadow-lg fade-in">
            <%- include('ingest-forms') %>
            <div class="flex justify-end mt-3">
                <button type="button" onclick="toggleIngestPanel()" class="px-3 py-1.5 text-xs text-gray-400 hover:text-white transition-colors">Close</button>
            </div>
        </div>

        <!-- Table card -->
        <div class="bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden shadow-lg">
            <!-- Toolbar -->
            <div class="bg-gray-850 border-b border-gray-800 px-4 py-2.5 flex items-center justify-between gap-3">
                <label class="flex items-center gap-2 text-xs text-gray-400 cursor-pointer select-none">
                    <input type="checkbox" id="kb-select-all" onchange="toggleAllKnowledgeBases(this)" class="accent-brand-500 w-4 h-4 cursor-pointer">
                    Select all
                </label>
                <button type="button" id="kb-delete-selected" onclick="deleteSelectedKnowledgeBases()" disabled
                        class="text-xs font-medium text-red-400 bg-red-500/10 border border-red-500/20 px-3 py-1.5 rounded-lg hover:bg-red-500/20 hover:text-red-300 disabled:opacity-40 disabled:cursor-not-allowed transition-all flex items-center gap-1.5">
                    <i class="ph ph-trash"></i> Delete Selected (<span id="kb-selected-count">0</span>)
                </button>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead class="bg-gray-900 border-b border-gray-800">
                        <tr class="text-[10px] uppercase tracking-wider text-gray-500">
                            <th class="px-4 py-3 w-10 text-center"></th>
                            <th class="px-4 py-3 whitespace-nowrap">Item ID</th>
                            <th class="px-4 py-3">HTML Name</th>
                            <th class="px-4 py-3">Title <span class="text-gray-600 normal-case tracking-normal">(editable)</span></th>
                            <th class="px-4 py-3 whitespace-nowrap">Who Added</th>
                            <th class="px-4 py-3">Status</th>
                            <th class="px-4 py-3 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="kb-table-body">
                        <%- include('kb-rows', { documents }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <p class="text-[11px] text-gray-600">
            Titles are saved immediately. Deleting a knowledge base also removes its Q&amp;A pairs.
        </p>
    </div>
</div>

<script>
    function toggleIngestPanel() {
        const panel = document.getElementById('ingest-panel');
        panel.classList.toggle('hidden');
        if (!panel.classList.contains('hidden')) {
            panel.querySelector('input[name="url"]')?.focus();
        }
    }

    function toggleAllKnowledgeBases(source) {
        document.querySelectorAll('#kb-table-body .kb-select').forEach(cb => { cb.checked = source.checked; });
        updateKnowledgeBaseSelection();
    }

    function updateKnowledgeBaseSelection() {
        const selected = document.querySelectorAll('#kb-table-body .kb-select:checked');
        const countEl  = document.getElementById('kb-selected-count');
        const deleteEl = document.getElementById('kb-delete-selected');
        const selectAll = document.getElementById('kb-select-all');
        const all      = document.querySelectorAll('#kb-table-body .kb-select');

        if (countEl) countEl.textContent = selected.length;
        if (deleteEl) deleteEl.disabled = selected.length === 0;
        if (selectAll) {
            selectAll.checked = all.length > 0 && selected.length === all.length;
            selectAll.indeterminate = selected.length > 0 && selected.length < all.length;
        }
    }

    function deleteSelectedKnowledgeBases() {
        const ids = [...document.querySelectorAll('#kb-table-body .kb-select:checked')].map(cb => cb.value);
        if (!ids.length) {
            showClientToast('Select at least one knowledge base to delete.');
            return;
        }
        if (!confirm(`Delete ${ids.length} knowledge base(s) and all of their Q&A pairs? This cannot be undone.`)) return;

        htmx.ajax('POST', '/api/documents/delete-selected', {
            values: { ids },
            target: '#kb-table-body',
            swap: 'innerHTML'
        });
    }

    // Keep the selection toolbar in sync after rows are added, removed or swapped.
    document.addEventListener('change', function (evt) {
        if (evt.target.classList && evt.target.classList.contains('kb-select')) {
            updateKnowledgeBaseSelection();
        }
    });
    document.body.addEventListener('htmx:afterSwap', function (evt) {
        if (evt.detail.target && evt.detail.target.id === 'kb-table-body') {
            updateKnowledgeBaseSelection();
            const total = document.querySelectorAll('#kb-table-body .kb-select').length;
            const totalEl = document.getElementById('kb-total-count');
            if (totalEl) totalEl.textContent = total;
        }
    });
    document.body.addEventListener('htmx:afterRequest', function (evt) {
        // A successful single-row delete removes the row client-side.
        if (evt.detail.elt && evt.detail.elt.matches && evt.detail.elt.matches('[hx-delete^="/api/documents/"]') && evt.detail.successful) {
            updateKnowledgeBaseSelection();
        }
    });

    updateKnowledgeBaseSelection();
</script>
