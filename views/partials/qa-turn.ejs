<!-- Multi-Turn Q&A Row Partial -->
<%
    const turnId      = (typeof turnIdPrefix !== 'undefined' && turnIdPrefix) ? `${turnIdPrefix}-${turnIndex}` : String(turnIndex);
    const blockId     = 'turn-block-' + turnId;
    const docSelector = (typeof documentIdSelector !== 'undefined' && documentIdSelector) ? documentIdSelector : '#current-document-id';
%>
<div class="qa-turn-block bg-gray-850 border border-gray-700 rounded-lg p-4 space-y-4 relative group shadow-sm" id="<%= blockId %>">
    <div class="flex justify-between items-center border-b border-gray-700/50 pb-2">
        <span class="text-xs font-bold text-brand-400 uppercase tracking-wider flex items-center gap-2">
            <i class="ph ph-chats text-base"></i> Turn <%= turnIndex %>
        </span>
        <% if (turnIndex > 1) { %>
            <button type="button" onclick="document.getElementById('<%= blockId %>').remove()" class="text-xs text-gray-500 hover:text-red-400 flex items-center gap-1 transition-colors">
                <i class="ph ph-trash"></i> Remove Turn
            </button>
        <% } %>
    </div>
    
    <!-- User Context & Question -->
    <div>
        <div class="flex items-center justify-between gap-2 mb-1">
            <label class="block text-xs font-medium text-brand-300 flex items-center gap-1.5">
                <i class="ph ph-user"></i> User Prompt
            </label>
            <div class="flex items-center gap-2">
                <button type="button"
                        hx-post="/api/qa/regenerate-question"
                        hx-include="<%= docSelector %>"
                        hx-target="#prompt-container-<%= turnId %>"
                        hx-swap="innerHTML"
                        hx-indicator="#spin-prompt-<%= turnId %>"
                        title="Generate a completely new question from scratch"
                        class="text-xs flex items-center gap-1.5 text-sky-400 hover:text-sky-300 bg-sky-500/10 hover:bg-sky-500/20 px-2.5 py-1.5 rounded transition-all border border-sky-500/20 shadow-sm font-medium">
                    <i id="spin-prompt-<%= turnId %>" class="ph ph-arrows-clockwise text-sm htmx-indicator-spin"></i> Regenerate
                </button>
                <button type="button"
                        hx-post="/api/qa/rewrite-question"
                        hx-vals='js:{previousQuestion: document.querySelector("#<%= blockId %> .turn-prompt-input").value}'
                        hx-target="#prompt-container-<%= turnId %>"
                        hx-swap="innerHTML"
                        hx-indicator="#spin-rewrite-prompt-<%= turnId %>"
                        title="Fix grammar and improve clarity while keeping the same question"
                        class="text-xs flex items-center gap-1.5 text-emerald-400 hover:text-emerald-300 bg-emerald-500/10 hover:bg-emerald-500/20 px-2.5 py-1.5 rounded transition-all border border-emerald-500/20 shadow-sm font-medium">
                    <i id="spin-rewrite-prompt-<%= turnId %>" class="ph ph-pencil-simple text-sm htmx-indicator-spin"></i> Rewrite
                </button>
            </div>
        </div>
        <div id="prompt-container-<%= turnId %>">
            <textarea name="turnPrompts[]" required rows="3" class="turn-prompt-input w-full bg-gray-900 border border-gray-700 text-gray-200 text-sm rounded-md focus:ring-brand-500 focus:border-brand-500 block p-2.5 outline-none resize-none transition-colors"><%= prompt || '' %></textarea>
        </div>
    </div>
    
    <!-- AI Assistant Answer -->
    <div class="pt-2 border-t border-gray-800/50">
        <div class="flex justify-between items-center mb-2">
            <label class="block text-xs font-medium text-purple-400 flex items-center gap-1.5">
                <i class="ph ph-robot"></i> Assistant Answer
            </label>
            
            <!-- HTMX Regenerate Button -->
            <div class="flex items-center gap-2">
                <button type="button"
                        hx-post="/api/qa/regenerate"
                        hx-include="#<%= blockId %>, <%= docSelector %>"
                        hx-vals='js:{regenPrompt: document.querySelector("#<%= blockId %> .turn-prompt-input").value}'
                        hx-target="#answer-container-<%= turnId %>"
                        hx-swap="innerHTML"
                        hx-indicator="#spin-<%= turnId %>"
                        title="Generate a completely new answer from scratch"
                        class="text-xs flex items-center gap-1.5 text-purple-400 hover:text-purple-300 bg-purple-500/10 hover:bg-purple-500/20 px-2.5 py-1.5 rounded transition-all border border-purple-500/20 shadow-sm font-medium">
                    <i id="spin-<%= turnId %>" class="ph ph-arrows-clockwise text-sm htmx-indicator-spin"></i> Regenerate Answer
                </button>
                <button type="button"
                        hx-post="/api/qa/rewrite"
                        hx-vals='js:{prompt: document.querySelector("#<%= blockId %> .turn-prompt-input").value, previousAnswer: (document.querySelector(`#answer-container-<%= turnId %> textarea[name="turnAnswers[]"]`)?.value || "")}'
                        hx-target="#answer-container-<%= turnId %>"
                        hx-swap="innerHTML"
                        hx-indicator="#spin-rewrite-<%= turnId %>"
                        title="Fix grammar and improve clarity while keeping the same meaning"
                        class="text-xs flex items-center gap-1.5 text-emerald-400 hover:text-emerald-300 bg-emerald-500/10 hover:bg-emerald-500/20 px-2.5 py-1.5 rounded transition-all border border-emerald-500/20 shadow-sm font-medium">
                    <i id="spin-rewrite-<%= turnId %>" class="ph ph-pencil-simple text-sm htmx-indicator-spin"></i> Rewrite
                </button>
            </div>
        </div>

        <div id="answer-container-<%= turnId %>">
            <textarea name="turnAnswers[]" required rows="3" class="w-full bg-gray-900 border border-purple-900/30 text-gray-100 text-sm rounded-md focus:ring-purple-500 focus:border-purple-500 block p-2.5 outline-none resize-none transition-colors"><%= answer || '' %></textarea>
        </div>
    </div>
</div>
